        let matches = items.features[i].properties.medium_m2m.filter(value => medium.includes(value.toString()));
        if (matches.length ==  0) {
          drop_items.push(items.features[i].id)
        } 
      };


      if (subjects.length > 0) {
        let matches = items.features[i].properties.subjects.filter(value => subjects.includes(value.toString()));
        if (matches.length ==  0) {
          drop_items.push(items.features[i].id)
        } 
      };


     
      if (locations.length > 0) {
        let matches = items.features[i].properties.locations.filter(value => locations.includes(value.toString()));
        if (matches.length == 0) {
          drop_items.push(items.features[i].id)
        } 
