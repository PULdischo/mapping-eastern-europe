{% extends 'base.njk' %}
{% block extra_css %}{% endblock%}
{% block content %}
<header class="masthead  d-flex">
  <div class="container my-auto">
    <div class="row">

      <div style="padding:10px;"
        class="text-left col-lg-12 mx-auto rounded text-dark text-center">
        <img class="img-fluid" src="/assets/img/main_logo.png" alt="" />
        
          <h1 id="met" style="margin-top: 20px;"><i>Mapping Eastern Europe</i> is a platform
          intended to promote study, teaching, and research about Eastern Europe between the 13th and 17th centuries
          through
          <b><a href="/category/historical-overviews">historical overviews</a></b>,
          <b><a href="/category/thematic-overviews">thematic overviews</a></b>,
          <b><a href="/category/case-studies">case-studies</a></b> 
          and <b><a href="/category/videos">videos</a></b> of monuments and objects,
          <b><a href="/category/ongoing-projects">ongoing projects</a></b>, as well as 
          <b><a href="/category/reviews">book reviews</a></b> and <b><a href="/category/exhibitions">exhibitions.</a></b></em><br></h1>

      </div>
    </div>

    <div class="d-flex justify-content-center">
      <a class="btn btn btn-outline-dark btn-xl js-scroll-trigger" role="button" href="#map">
        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-globe2" fill="currentColor"
          xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd"
            d="M1.018 7.5h2.49c.037-1.07.189-2.087.437-3.008a9.124 9.124 0 0 1-1.565-.667A6.964 6.964 0 0 0 1.018 7.5zM3.05 3.049c.362.184.763.349 1.198.49.142-.384.304-.744.481-1.078a6.7 6.7 0 0 1 .597-.933A7.01 7.01 0 0 0 3.051 3.05zM8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm-.5 1.077c-.67.204-1.335.82-1.887 1.855-.143.268-.276.56-.395.872.705.157 1.473.257 2.282.287V1.077zm0 4.014c-.91-.03-1.783-.145-2.591-.332a12.344 12.344 0 0 0-.4 2.741H7.5V5.091zm1 2.409V5.091c.91-.03 1.783-.145 2.591-.332.223.827.364 1.754.4 2.741H8.5zm-1 1H4.51c.035.987.176 1.914.399 2.741A13.596 13.596 0 0 1 7.5 10.91V8.5zm1 2.409V8.5h2.99a12.343 12.343 0 0 1-.399 2.741A13.596 13.596 0 0 0 8.5 10.91zm-1 1c-.81.03-1.577.13-2.282.287.12.312.252.604.395.872.552 1.035 1.218 1.65 1.887 1.855V11.91zm-2.173 2.563a6.695 6.695 0 0 1-.597-.933 8.857 8.857 0 0 1-.481-1.078 8.356 8.356 0 0 0-1.198.49 7.01 7.01 0 0 0 2.276 1.52zM2.38 12.175c.47-.258.995-.482 1.565-.667A13.36 13.36 0 0 1 3.508 8.5h-2.49a6.964 6.964 0 0 0 1.362 3.675zm8.293 2.297a7.01 7.01 0 0 0 2.275-1.521 8.353 8.353 0 0 0-1.197-.49 8.859 8.859 0 0 1-.481 1.078 6.688 6.688 0 0 1-.597.933zm.11-2.276A12.63 12.63 0 0 0 8.5 11.91v3.014c.67-.204 1.335-.82 1.887-1.855.143-.268.276-.56.395-.872zm1.272-.688c.57.185 1.095.409 1.565.667A6.964 6.964 0 0 0 14.982 8.5h-2.49a13.355 13.355 0 0 1-.437 3.008zm.437-4.008h2.49a6.963 6.963 0 0 0-1.362-3.675c-.47.258-.995.482-1.565.667.248.92.4 1.938.437 3.008zm-.74-3.96a8.854 8.854 0 0 0-.482-1.079 6.692 6.692 0 0 0-.597-.933c.857.355 1.63.875 2.275 1.521a8.368 8.368 0 0 1-1.197.49zm-.97.264c-.705.157-1.473.257-2.282.287V1.077c.67.204 1.335.82 1.887 1.855.143.268.276.56.395.872z" />
        </svg><br>
        
        <svg width="2em" height="2em" viewBox="0 0 16 16" class="bi bi-chevron-down" fill="currentColor"
          xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd"
            d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" />
        </svg>
      </a></div>
  </div>

</header>

<section>
  <div id="map" class="container" style="padding-top: 20px;">
    
    <div class="row">
      <div class="col-lg-2 order-2 order-lg-1">
        <form>

          <div class="form-group">

            <input type="text" class="form-control" id="query" placeholder="Search...">
            <button type="button" onclick="reset_map();" class="btn btn-sm btn-light">Reset Map</button>

            <hr>

            <label for="subject">Entry</label>
            <select style="width: 100%;" class="select2-type" multiple="multiple"></select>
            <label for="medium">Type</label>
            <select style="width: 100%;" class="select2-medium" multiple="multiple"></select>
            <label for="location">Location</label>
            <select style="width: 100%;" class="select2-location" multiple="multiple"></select>
            <label for="subject">Subject</label>
            <select style="width: 100%;" class="select2-subject"  multiple="multiple"></select>
            <label for="author">Author</label>
            <select style="width: 100%;" class="select2-author"></select>            
            
          
            <hr>

            <div class="card" style="background-color: #f3efef;">
              <div class="card-body">
                <p>Legend</p>
                {% for category in categories %}
                <img style="height:25px; width:25px" src="{{ category.marker_image }}" /><span
                  style="font-size:x-small;">&nbsp;{{ category.name }}</span><br>
                  <hr style="border-width: 1px; ">
                {% endfor %}
              </div>
            </div>
          </div>


        </form>
      </div>
      <div class="col-lg-10 order-1 order-lg-2">

        <label for="amount">Date range:</label>
        <input type="text" id="amount" readonly style="border:0; background-color: white;">

        <style>
          #slider {
            margin: 10px;
          }
          
        </style>
        <div id="slider"></div>
        <!-- http://bl.ocks.org/zross/47760925fcb1643b4225 -->
        <div id="mapid" style="width:100%;"></div>
      </div>
    </div>

  </div>
</section>
{% endblock%}

{% block extra_js%}

<script>
  // Limit area of map to Eastern Europe
  // https://jsfiddle.net/MaxHeadroom/s6h40xrn/44/

  var corner1 = L.latLng(62.4826108542, 7.5231909157);
  var corner2 = L.latLng(33.5488222335, 57.5915493966);
  var bounds = L.latLngBounds(corner1, corner2);
  var map = L.map('mapid', {
    zoomControl: false,
    zoomSnap: 0.25,
    zoomDelta: 0.125,
    wheelPxPerZoomLevel: 60,
    zoomControl: false,
  }).setView([50, 8.6], 8);
  var wmsLayer = L.esri.basemapLayer('ShadedRelief').addTo(map);
  //add zoom control with your options
  L.control.zoom({
    position: 'topright'
  }).addTo(map);

  map.fitBounds(bounds, true); // <-- without second arg, map.getZoom() will return a wrong value!
  map.setMinZoom(map.getZoom());
  map.on({ resize: map_onResize });

  function map_onResize(e) {
    map.invalidateSize(false);

    map.fitBounds(bounds, true);
    map.setMinZoom(map.getZoom());
  }

  let items = {{ collections.FeatureCollection | dump | safe }};


  //   hide the leaflet and esri label on the map
  document.querySelectorAll('.leaflet-control-attribution').forEach(el => el.style.display = 'none');

  // initialize the date slider 
  const sliderElement = document.getElementById('slider');
  const amountElement = document.getElementById('amount');
  
  $(sliderElement).slider({
    range: true,
    min: 1150,
    max: 1750,
    values: [1150, 1750],
    slide: function (event, ui) {
      amountElement.value = ui.values[0] + " - " + ui.values[1];
      make_map();
    }
  });
  amountElement.value = $(sliderElement).slider("values", 0) + " - " + $(sliderElement).slider("values", 1);
</script>
<!-- MAP FILTER AND SEARCH -->
<script>
function make_map() {
  // Clear existing points on the map
  map.eachLayer(function (layer) {
    if (!!layer.toGeoJSON) {
      map.removeLayer(layer);
    }
  });
  
  // Collect search parameters
  const query = document.getElementById('query').value;
  const selectedTypes = Array.from(document.querySelector('.select2-type').selectedOptions || []).map(opt => opt.value);
  const selectedSubjects = Array.from(document.querySelector('.select2-subject').selectedOptions || []).map(opt => opt.value);
  const selectedLocations = Array.from(document.querySelector('.select2-location').selectedOptions || []).map(opt => opt.value);
  const selectedMedium = Array.from(document.querySelector('.select2-medium').selectedOptions || []).map(opt => opt.value);
  const selectedAuthorEl = document.querySelector('.select2-author');
  const selectedAuthor = selectedAuthorEl ? selectedAuthorEl.value : null;
  const startYear = $(sliderElement).slider("values", 0);
  const endYear = $(sliderElement).slider("values", 1);


  // Helper function to check if a feature passes all filters
  function passesFilters(feature) {
    const props = feature.properties;
    
    // Text search filter
    if (query) {
      const title = props.popupcontent
        .replace(/<[^>]*>/g, '') // Remove HTML tags
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase();
      if (!title.includes(query.normalize('NFD').replace(/[\u0300-\u036f]/g, "").toLowerCase())) {
        return false;
      }
    }

    // Category filter (with default categories when none selected)
    if (selectedTypes.length > 0) {
      if (!selectedTypes.includes(props.category)) {
        return false;
      }
    } else {
      // Show only default categories when no filter is applied
      const defaultCategories = ['case-studies', 'historical-overviews', 'thematic-overviews', 'videos'];
      if (!defaultCategories.includes(props.category)) {
        return false;
      }
    }
    
    // Type/ Medium filter
    if (selectedMedium.length > 0) {
      const itemMedium = props.type || [];
      if (!itemMedium.some(m => selectedMedium.includes(m.toString()))) {
        return false;
      }
    }

    // Subjects filter
    if (selectedSubjects.length > 0) {
      const itemSubjects = props.subjects || [];
      if (!itemSubjects.some(s => selectedSubjects.includes(s.toString()))) {
        return false;
      }
    }

    // Locations filter
    if (selectedLocations.length > 0) {
      const itemLocations = props.locations || [];
      if (!itemLocations.some(l => selectedLocations.includes(l.toString()))) {
        return false;
      }
    }
 
    // Author filter
    if (selectedAuthor && props.authors !== selectedAuthor) {
      return false;
    }

    // Date range filter
    const itemStartYear = props.start_year || startYear;
    const itemEndYear = props.end_year || endYear;
    
    // Check if date ranges overlap
    if (itemEndYear < startYear || itemStartYear > endYear) {
      return false;
    }

    return true;
  }

  // Create filtered GeoJSON for each category
  function createCategoryLayer(categoryName, iconUrl) {
    const icon = new L.Icon({
      iconUrl: iconUrl,
      iconSize: [30, 30],
      iconAnchor: [15, 30],
      popupAnchor: [-30, -30],
      shadowSize: [30, 30]
    });

    const coords = [];
    const popups = [];

    return L.geoJSON(items, {
      pointToLayer: function (feature, latlng) {
        return L.marker(latlng, { icon: icon });
      },
      filter: function(feature) {
        return feature.properties.category === categoryName && passesFilters(feature);
      },
      onEachFeature: function(feature, layer) {
        coords.push(feature.geometry.coordinates);
        popups.push(feature.properties.popupcontent);

        // Group overlapping markers
        const grouped = [];
        const groupedPopups = [];

        for (let i = 0; i < coords.length; i++) {
          let found = false;
          for (let j = 0; j < grouped.length; j++) {
            if (grouped[j][0][0] === coords[i][0] && grouped[j][0][1] === coords[i][1]) {
              grouped[j].push(coords[i]);
              groupedPopups[j].push(popups[i]);
              found = true;
              break;
            }
          }
          if (!found) {
            grouped.push([coords[i]]);
            groupedPopups.push([popups[i]]);
          }
        }

        // Find which group this feature belongs to
        let groupIndex = 0;
        for (let k = 0; k < grouped.length; k++) {
          if (grouped[k][0][0] === feature.geometry.coordinates[0] && 
              grouped[k][0][1] === feature.geometry.coordinates[1]) {
            groupIndex = k;
            break;
          }
        }

        // Build popup content
        let content = groupedPopups[groupIndex][0];
        for (let t = 1; t < groupedPopups[groupIndex].length; t++) {
          const brIndex = groupedPopups[groupIndex][t].indexOf("br>");
          const popupText = groupedPopups[groupIndex][t].substring(brIndex + 3);
          content += "<hr>" + popupText;
          
          if (t > 10) {
            content += `<p>and ${groupedPopups[groupIndex].length - t} more results. Narrow down your search!</p>`;
            break;
          }
        }

        layer.bindPopup(`<p>${content}</p>`, { maxWidth: "auto" });
      }
    }).addTo(map);
  }

  // Create layers for all categories
  createCategoryLayer("historical-overviews", '/assets/media/icons/overviews-icon.png');
  createCategoryLayer("case-studies", '/assets/media/icons/case-studies-icon.png');
  createCategoryLayer("book-reviews", '/assets/media/icons/book-reviews-icon.png');
  createCategoryLayer("ongoing-projects", '/assets/media/icons/ongoing-projects-icon.png');
  createCategoryLayer("thematic-overviews", '/assets/media/icons/thematic-overview-icon.png');
  createCategoryLayer("videos", '/assets/media/icons/videos-icon.png');
}
</script>
<!-- SELECT2 SECTION -->
<script>
  // Extract unique values for dropdown filters
  const uniqueCategories = [];
  const uniqueSubjects = [];
  const uniqueLocations = [];
  const uniqueAuthors = [];
  const uniqueMedium = [];

  const categoryIds = new Set();
  const subjectIds = new Set();
  const locationIds = new Set();
  const authorNames = new Set();
  const mediumTypes = new Set();

  items.features.forEach(feature => {
    // Categories
    if (feature.properties.category) {
      const catId = feature.properties.category.toString();
      if (catId && !categoryIds.has(catId)) {
        categoryIds.add(catId);
        const displayText = catId.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
        uniqueCategories.push({ id: catId, text: displayText });
      }
    }
    // Medium
    if (feature.properties.type && Array.isArray(feature.properties.type)) {
      feature.properties.type.forEach(medium => {
        if (medium !== null && medium !== '' && !mediumTypes.has(medium.toString())) {
          mediumTypes.add(medium.toString());
          uniqueMedium.push({ id: medium.toString(), text: medium.toString() });
        }
      });
    }
    // Subjects
    if (feature.properties.subjects && Array.isArray(feature.properties.subjects)) {
      feature.properties.subjects.forEach(subId => {
        if (subId !== null && subId !== '' && !subjectIds.has(subId.toString())) {
          subjectIds.add(subId.toString());
          uniqueSubjects.push({ id: subId.toString(), text: subId.toString() });
        }
      });
    }

    // Locations
    if (feature.properties.locations && Array.isArray(feature.properties.locations)) {
      feature.properties.locations.forEach(locId => {
        if (locId !== null && locId !== '' && !locationIds.has(locId.toString())) {
          locationIds.add(locId.toString());
          uniqueLocations.push({ id: locId.toString(), text: locId.toString() });
        }
      });
    }

    // Authors
    if (feature.properties.authors && typeof feature.properties.authors === 'string') {
      const authorName = feature.properties.authors.trim();
      const excludedCategories = ["book-reviews", "exhibitions", "ongoing-projects"];
      if (
        authorName &&
        !authorNames.has(authorName) &&
        !excludedCategories.includes(feature.properties.category)
      ) {
        authorNames.add(authorName);
        uniqueAuthors.push({ id: authorName, text: authorName });
      }
    }
  });
 
  $('.select2-type').select2({
    data: uniqueCategories,
    theme: 'bootstrap4',
  });

  $('.select2-subject').select2({
    data: uniqueSubjects,
    theme: 'bootstrap4',
  });
  $('.select2-location').select2({
    data: uniqueLocations,
    theme: 'bootstrap4',
  });
  $('.select2-medium').select2({
    data: uniqueMedium,
    theme: 'bootstrap4',
  });
  $('.select2-author').select2({
    data: uniqueAuthors,
    theme: 'bootstrap4',
  });

  $('.select2-author').on('select2:select', function (e) {
    make_map();
  });

  $('.select2-author').on('select2:unselect', function (e) {
    make_map();
  });


  $('.select2-medium').on('select2:select', function (e) {
    make_map();
  });

  $('.select2-medium').on('select2:unselect', function (e) {
    make_map();
  });

  $('.select2-location').on('select2:select', function (e) {
    make_map();
  });

  $('.select2-location').on('select2:unselect', function (e) {
    make_map();
  });

  $('.select2-subject').on('select2:select', function (e) {
    make_map();
  });

  $('.select2-subject').on('select2:unselect', function (e) {
    make_map();
  });

  $('.select2-type').on('select2:select', function (e) {
    make_map();
  });

  $('.select2-type').on('select2:unselect', function (e) {
    make_map();
  });

  const queryInput = document.getElementById('query');
  queryInput.addEventListener('input', function(e) {
    if (e.keyCode === 13) {
      e.preventDefault();
      make_map();
    }
    else {
      make_map();
    }
  });

  // helper function to remove value from array
  // https://stackoverflow.com/questions/3954438/how-to-remove-item-from-array-by-value
  Array.prototype.remove = function () {
    var what, a = arguments, L = a.length, ax;
    while (L && this.length) {
      what = a[--L];
      while ((ax = this.indexOf(what)) !== -1) {
        this.splice(ax, 1);
      }
    }
    return this;
  };
</script>

<script>
  function reset_map() {
    $('#query').val('');
    $('.select2-type').val(null).trigger('change');
    $('.select2-subject').val(null).trigger('change');
    $('.select2-location').val(null).trigger('change');
    $('.select2-medium').val(null).trigger('change');
    $('.select2-author').val(null).trigger('change');
    make_map();
  };


</script>

<script>


  // call make map for initial state before filters and search
  reset_map();
 
</script>
{% endblock %}

