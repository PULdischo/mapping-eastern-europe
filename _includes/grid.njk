{% extends 'base.njk' %}

{% block extra_css %}
<link rel="stylesheet" href="/assets/css/shuffle.css">

{% endblock%}
{% block content %}
<section>
  
          
          <div class="mx-auto cta-inner0 text-center">
              <div style="margin-bottom: 20px;">
                  <img class="mx-auto img-fluid" src="/assets/img/main_logo.png" alt="" />
              </div>

                <div class="filters-group mx-auto">
                  <label for="filters-search-input" class="filter-label">Search</label>
                  <input class="textfield filter__search js-shuffle-search" type="search" id="filters-search-input" />
                </div>
              </div>
              <div id="grid" class=" row my-shuffle-container mx-auto">
                <style>.border-3 {
                  border-width:4px !important;
                  border-color: #d1ded9;
              }
              </style>
                
            
               
              </div>
              <div class="text-center" style="margin-top: 20px;">
                <button id="load-more-btn" class="btn btn-primary">Load More</button>
              </div>
            </div>


          </div>
        </div>
      </div>
    </div>
  </section>

  {% endblock %}

  {% block extra_js %}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Shuffle/5.2.3/shuffle.js"></script>
  <script>
    // create an array from the collection with item.slug, item.title, item.item_image, item.author, item.subject_names, item.location_names
    {% set listCollection = listCollection | default("items") %}
    console.log("Using collection: {{ listCollection }}");
    let collection = [  
      {% for item in collections[listCollection] %}
        {
          slug: "{{ item.data.slug }}",
          title: "{{ item.data.title|safe }}",
          thumbnail: "{{ item.data.item_image }}",
          subject_names: "{{ item.data.subject_names | join(", ") }}",
          location_names: "{{ item.data.location_names | join(", ") }}",

       
        },
      {% endfor %}
      ];
    
    // create a smaller array from collection with 5 
    console.log(collection.length);
    let Shuffle = window.Shuffle;


    

    class Demo {
      constructor(element) {
        this.element = element;
        this.shuffle = new Shuffle(element, {
          itemSelector: '.js-item',
          sizer: element.querySelector('.my-sizer-element'),
        });

        // Log events.
        this.addShuffleEventListeners();
        this._activeFilters = [];
        this.addSearchFilter();
      }

      /**
       * Shuffle uses the CustomEvent constructor to dispatch events. You can listen
       * for them like you normally would (with jQuery for example).
       */
      addShuffleEventListeners() {
    
        this.shuffle.on(Shuffle.EventType.LAYOUT, (data) => {
          // console.log('layout. shuffle.js', data);
        });
        this.shuffle.on(Shuffle.EventType.REMOVED, (data) => {
          // console.log('removed. shuffle.js', data);
        });
      };


      // Advanced filtering
      addSearchFilter() {
        const searchInput = document.querySelector('.js-shuffle-search');
        if (!searchInput) {
          return;
        }
        searchInput.addEventListener('keyup', this._handleSearchKeyup.bind(this));
      }

      /**
       * Filter the shuffle instance by items with a title that matches the search input.
       * @param {Event} evt Event object.
       */
      _handleSearchKeyup(evt) {
        const searchText = evt.target.value.normalize('NFD').replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
        this.shuffle.filter((element, shuffle) => {
         
          const titleElement = element.querySelector('.picture-item__title');
          const titleText = titleElement.getAttribute("name").normalize('NFD').replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
          return titleText.indexOf(searchText) !== -1;
        });
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      window.demo = new Demo(document.getElementById('grid'));
      let elements = [];
      // randomize the collection
      collection = collection.sort(() => Math.random() - 0.5);
      
      collection.forEach((item, index) => {
          const element = document.createElement('figure');
          element.style.paddingRight = '10px';
          element.classList.add('rounded', 'js-item', 'img-item', 'col-4@sm', 'col-4@xs');
          element.setAttribute('data-date-created', item.created);
          element.setAttribute('data-groups', item.groups);
          element.setAttribute('data-title', item.title);
          element.setAttribute('data-author', item.author);

          if (index <= 10) {
            let element_string = `
              
                          <div>
                            <div>
                              <a href="/item/${ item.slug }/" target="_blank" rel="noopener"
                                  title="${ item.title }">
                                  <img src="${ item.thumbnail }" alt="${ item.title }"  />
                              </a>
                            </div>
                          </div>
                          <figcaption class="picture-item__title" name="${ item.title } ${ item.author}  ${ item.subject_names } ${ item.location_names}"><a href="${ item.slug }" target="_blank">${ item.title }</a></figcaption>  

      
            `;
          element.innerHTML = element_string;  
          elements.push(element);
          }
          else {
              let element_string = `
                  
                              <div>
                                <div>
                                  <a href="/item/${ item.slug }/" target="_blank" rel="noopener"
                                      title="${ item.title }">
                                      <img class="d-none" src="${ item.thumbnail }" alt="${ item.title }"  />
                                  </a>
                                </div>
                              </div>
                              <figcaption class="d-none picture-item__title" name="${ item.title } ${ item.author}  ${ item.subject_names } ${ item.location_names}"><a href="${ item.slug }" target="_blank">${ item.title }</a></figcaption>
                  
                `;
        element.innerHTML = element_string;  
        elements.push(element);
              }
          
          
        
      });
          
      elements.forEach((element) => {
        demo.shuffle.element.appendChild(element);  
      });
      demo.shuffle.add(elements);
      demo.shuffle.enable();
      
      // Array.from(demo.shuffle.element.children).forEach((child) => {
      //   const img = child.querySelector('img.d-none');
      //   const caption = child.querySelector('.picture-item__title.d-none');
      //   if (img) {
      //     img.classList.remove('d-none');
      //   }
      //   if (caption) {
      //     caption.classList.remove('d-none');
      //   }
      // }); 

      const loadMoreButton = document.getElementById('load-more-btn');
      let itemsToShow = 10; // Number of items to show per click
      let initialVisibleItems = 11; // Already visible items

      loadMoreButton.addEventListener('click', () => {
        const hiddenItems = Array.from(demo.shuffle.element.querySelectorAll('.js-item img.d-none'));
        const itemsToReveal = hiddenItems.slice(0, itemsToShow);

        itemsToReveal.forEach(itemElement => {
          // Find the parent figure element to get both img and figcaption
          const figureElement = itemElement.closest('.js-item');
          if (figureElement) {
            const img = figureElement.querySelector('img.d-none');
            const caption = figureElement.querySelector('.picture-item__title.d-none');
            if (img) {
              img.classList.remove('d-none');
            }
            if (caption) {
              caption.classList.remove('d-none');
            }
          }
        });

        demo.shuffle.update();

        if (hiddenItems.length <= itemsToShow) {
          loadMoreButton.style.display = 'none'; // Hide button if no more items
        }
      });
      
    });

  </script>
  {% endblock %}
